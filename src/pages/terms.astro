---
import Base from '../layouts/Base.astro';
import { site } from '../site.config.js';
const sections = [
  ['agreement', 'About these terms'],
  ['licence', 'Your licence to use AI Assist'],
  ['acceptable-use', 'Acceptable use'],
  ['ai-output', 'AI-generated output'],
  ['plans', 'Plans, fees and changes'],
  ['data', 'Your data and AI providers'],
  ['liability', 'Warranties and liability'],
  ['termination', 'Ending the agreement'],
  ['law', 'Governing law'],
];
---
<Base title="Terms of service">
  <section class="section-sm">
    <div class="container narrow prose">
      <nav class="legal-tabs" aria-label="Legal">
        <a href="/privacy">Privacy policy</a>
        <a href="/terms" aria-current="page">Terms of service</a>
      </nav>
      <h1 style="font-size: clamp(1.8rem, 4vw, 2.6rem)">Terms of service</h1>
      <p class="muted small">Last updated {site.placeholders.legalLastUpdated}</p>
      <p class="callout">Draft structure only. The full text is being prepared with a solicitor and must replace the placeholders below before launch.</p>
      <nav class="toc" aria-label="Contents">
        {sections.map(([id, label], i) => <a href={`#${id}`}>{i + 1}. {label}</a>)}
      </nav>
      {sections.map(([id, label], i) => (
        <>
          <h2 id={id}>{i + 1}. {label}</h2>
          <p>[Text to come.]</p>
        </>
      ))}
      <p>Questions about these terms: <a href={`mailto:${site.email.hello}`}>{site.email.hello}</a></p>
    </div>
  </section>
</Base>
