---
import PolicyPage from '../layouts/PolicyPage.astro';
import { site } from '../site.config.js';
const sections = [
  { id: 'agreement', label: 'About these terms' },
  { id: 'licence', label: 'Your licence to use AI Assist' },
  { id: 'acceptable-use', label: 'Acceptable use' },
  { id: 'ai-output', label: 'AI-generated output' },
  { id: 'plans', label: 'Plans, fees and changes' },
  { id: 'data', label: 'Your data and AI providers' },
  { id: 'liability', label: 'Warranties and liability' },
  { id: 'termination', label: 'Ending the agreement' },
  { id: 'law', label: 'Governing law' },
];
---
<PolicyPage title="Terms of service" description="The terms for using AI Assist." draft sections={sections}>
  <p slot="acceptable-use">Your use of AI Assist must follow our <a href="/acceptable-use">Acceptable Use Policy</a>. [Full text to come.]</p>
  <p slot="ai-output">See <a href="/ai-transparency">AI transparency</a> for what AI Assist can and can't do. [Full text to come.]</p>
  <p slot="after">Questions about these terms: <a href={`mailto:${site.email.hello}`}>{site.email.hello}</a></p>
</PolicyPage>
