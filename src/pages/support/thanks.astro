---
import Base from '../../layouts/Base.astro';
import Check from '../../components/Check.astro';
import { site } from '../../site.config.js';
---
<Base title="Request received">
  <section class="section">
    <div class="container narrow stack stack-md center">
      <span class="confirm-icon"><Check size={36} /></span>
      <h1>Request received</h1>
      <p class="lead">We've logged your request and will reply to the email address you gave us. Our response times are on the <a href="/support">support page</a>.</p>
      <p class="muted">Urgent? Email <a href={`mailto:${site.email.support}`}>{site.email.support}</a> and quote the email address and subject you used.</p>
      <div class="btn-row btn-row-center">
        <a class="btn btn-outline" href="/support">Raise another request</a>
        <a class="btn btn-primary" href="/documentation">Browse the documentation</a>
      </div>
    </div>
  </section>
</Base>
