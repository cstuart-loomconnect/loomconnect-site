---
import Base from '../../layouts/Base.astro';
import { site, salesforce, salesforceReady } from '../../site.config.js';

const wtc = salesforce.webToCase;
const action = salesforceReady ? wtc.action : '/support/thanks';
const method = salesforceReady ? 'post' : 'get';
const orgIdName = wtc.orgIdFieldId || 'salesforce_org_id';
---
<Base title="Support" description="Get help with AI Assist: docs, email support and support requests.">
  <section class="section-sm bg-soft">
    <div class="container stack-lg">
      <div class="stack">
        <h1>How can we help?</h1>
        <p class="lead">Most setup questions are answered in the docs. If not, raise a request and you'll get a case number straight away.</p>
      </div>
      <div class="grid">
        <a class="card card-link" href="/docs">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#1E1B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2zM4 19V5" /></svg>
          <h2 style="font-size: 1.1rem">Getting-started docs</h2>
          <p>Install, permission sets and page setup</p>
        </a>
        <a class="card card-link" href={`mailto:${site.email.support}`}>
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#1E1B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
          <h2 style="font-size: 1.1rem">{site.email.support}</h2>
          <p>Emails become a support case automatically</p>
        </a>
        <div class="card">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#1E1B4B" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          <h2 style="font-size: 1.1rem">Response times</h2>
          <p>Free: {site.placeholders.freeResponseTime}. Pro: next working day. Enterprise: per your SLA. UK hours, Monday to Friday.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container narrow">
      <!-- Web-to-Case form. Settings live in src/site.config.js. -->
      <form class="form-card" action={action} method={method} aria-label="Raise a support request">
        {salesforceReady && (
          <>
            <input type="hidden" name="orgid" value={salesforce.orgId} />
            <input type="hidden" name="retURL" value={wtc.returnUrl} />
          </>
        )}
        <h2 style="font-size: 1.5rem">Raise a support request</h2>
        {!salesforceReady && <p class="dev-banner">Preview mode: this form isn't connected to Salesforce yet.</p>}

        <div class="field-row">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" maxlength="80" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" maxlength="80" placeholder="name@company.com" required />
          </div>
        </div>
        <div class="field">
          <label for="org_id">Salesforce Org ID (optional)</label>
          <input id="org_id" name={orgIdName} type="text" maxlength="18" placeholder="00D5g000001AbCd" />
          <span class="hint">Find it in Setup › Company Information. It helps us find your licence quickly.</span>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="type">Category</label>
            <select id="type" name="type">
              <option value="Installation">Installation</option>
              <option value="Configuration">Configuration</option>
              <option value="Problem">Something isn't working</option>
              <option value="Licensing">Licensing</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="field">
            <label for="priority">Priority</label>
            <select id="priority" name="priority">
              <option value="Low">Low</option>
              <option value="Medium" selected>Medium</option>
              <option value="High">High: blocking my team</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <input id="subject" name="subject" type="text" maxlength="80" required />
        </div>
        <div class="field">
          <label for="description">What's happening?</label>
          <textarea id="description" name="description" rows="5" required></textarea>
        </div>

        <!-- reCAPTCHA widget from Salesforce goes here -->

        <button class="btn btn-primary btn-block" type="submit">Submit request</button>
        <p class="hint" style="text-align: center">You'll get a confirmation email with your case number.</p>
      </form>
    </div>
  </section>
</Base>
