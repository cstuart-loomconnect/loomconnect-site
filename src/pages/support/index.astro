---
import Base from '../../layouts/Base.astro';
import FormGuard from '../../components/FormGuard.astro';
import Turnstile from '../../components/Turnstile.astro';
import { site } from '../../site.config.js';
import { useProxy } from '../../site-key.js';

// The form posts to the Worker, which adds the org ID and talks to Salesforce.
// With no Turnstile key (local preview) it goes straight to the thank-you page instead.
const action = useProxy ? '/api/support' : '/support/thanks';
const method = useProxy ? 'post' : 'get';
---
<Base title="Support" description="Get help with LoomConnect AI: documentation, email support and support requests.">
  <section class="section-sm bg-soft">
    <div class="container stack-lg">
      <div class="stack">
        <h1>How can we help?</h1>
        <p class="lead">Most setup questions are answered in the documentation. If not, raise a request and you'll get a case number straight away.</p>
      </div>
      <div class="grid">
        <a class="card card-link" href="/documentation">
          <h2 class="h-card">Documentation</h2>
          <p>Setup steps, every error message and how to fix it</p>
        </a>
        <a class="card card-link" href={`mailto:${site.email.support}`}>
          <h2 class="h-card">{site.email.support}</h2>
          <p>Emails become a support case automatically</p>
        </a>
        <div class="card">
          <h2 class="h-card">Response times</h2>
          <p>Free: {site.pricing.freeResponseTime}. Pro: next working day. Enterprise: per your SLA. UK hours, Monday to Friday.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container narrow">
      <!-- Support form. Posts to the Worker (src/worker.js), which forwards to Salesforce Web-to-Case. -->
      <form class="form-card" action={action} method={method} aria-label="Raise a support request">
        <h2 class="h-section">Raise a support request</h2>
        {!useProxy && <p class="dev-banner">Preview mode: this form isn't connected to Salesforce yet.</p>}

        <div class="field-row">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" maxlength="80" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" maxlength="80" placeholder="name@company.com" required />
          </div>
        </div>
        <div class="field">
          <label for="org_id">Salesforce Org ID (optional)</label>
          <input id="org_id" name="org_id" type="text" maxlength="18" placeholder="00D5g000001AbCd" />
          <span class="hint">Find it in Setup › Company Information. It helps us find your licence quickly.</span>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="type">Category</label>
            <select id="type" name="type">
              <option value="Installation">Installation</option>
              <option value="Configuration">Configuration</option>
              <option value="Problem">Something isn't working</option>
              <option value="Licensing">Licensing</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="field">
            <label for="priority">Priority</label>
            <select id="priority" name="priority">
              <option value="Low">Low</option>
              <option value="Medium" selected>Medium</option>
              <option value="High">High: blocking my team</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <input id="subject" name="subject" type="text" maxlength="80" required />
        </div>
        <div class="field">
          <label for="description">What's happening?</label>
          <textarea id="description" name="description" rows="5" required></textarea>
        </div>

        <FormGuard proxy={useProxy} />
        <Turnstile />

        <button class="btn btn-primary btn-block" type="submit">Submit request</button>
        <p class="hint text-center">You'll get a confirmation email with your case number.</p>
      </form>
    </div>
  </section>
</Base>
