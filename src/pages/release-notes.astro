---
import Base from '../layouts/Base.astro';
import Check from '../components/Check.astro';
import { site } from '../site.config.js';

// Add a new entry at the top for each promoted package version.
const releases = [
  {
    version: site.placeholders.currentVersion,
    date: site.placeholders.releaseDate,
    title: 'First release',
    notes: [
      'AI chat assistant on Lightning record pages',
      'Anthropic and OpenAI support using your own API key',
      'Slash commands from prompt templates',
      'PII pseudonymisation before data reaches the model',
      'Audit log, usage rules and conversation retention',
    ],
  },
];
---
<Base title="Release notes" description="What's new in each version of LoomConnect AI.">
  <section class="section-sm">
    <div class="container narrow stack stack-md">
      <h1 class="page-title">What's new in LoomConnect AI</h1>
      <p class="lead">Every package version, newest first. Upgrades install in place with no data loss.</p>
      {releases.map((r) => (
        <article class="release">
          <div class="release-head">
            <h2 class="h-release">Version {r.version}</h2>
            <span class="muted small">{r.date}</span>
            <span class="pill">{r.title}</span>
          </div>
          <ul class="ticks ticks-tight">
            {r.notes.map((n) => <li><Check />{n}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
</Base>
