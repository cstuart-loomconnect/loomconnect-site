---
import Base from '../layouts/Base.astro';
import Check from '../components/Check.astro';
import { site } from '../site.config.js';
const p = site.pricing;
---
<Base title="Pricing" description={`LoomConnect AI pricing: one price per Salesforce org with unlimited users. Free forever, Pro at ${p.proAnnual} a month, and Enterprise for regulated industries.`}>
  <section class="section">
    <div class="container stack-lg">
      <div class="stack center">
        <h1>Pay for the data you connect, not the people who use it.</h1>
        <p class="lead">One price per Salesforce org, with unlimited users on every plan. Plans grow with the data sources and agents you configure.</p>
      </div>

      <div class="plans">
        <div class="plan plan-featured">
          <div class="plan-head"><h2 class="h-plan">Free</h2><span class="pill">Standard</span></div>
          <div class="plan-pricing">
            <div class="plan-price"><strong>£0</strong><span class="muted">forever</span></div>
            <p class="plan-note muted small">Unlimited users.</p>
          </div>
          <ul>
            <li><Check />{p.freeDataSources} Salesforce data sources connected to {p.freeAgents} configured agent</li>
            <li><Check />Send to Anthropic or OpenAI with your own API key</li>
            <li><Check />Personal data pseudonymised before it reaches your provider</li>
            <li><Check />Audit log of what was sent</li>
            <li><Check />Chat, summaries, drafts and slash commands on any record page</li>
            <li><Check />Email support, reply within {p.freeResponseTime}</li>
          </ul>
          <a class="btn btn-primary btn-block" href={site.appExchangeUrl}>Get it on AppExchange</a>
        </div>

        <div class="plan">
          <div class="plan-head"><h2 class="h-plan">Pro</h2><span class="pill pill-violet">For growing teams</span></div>
          <div class="plan-pricing">
            <div class="plan-price"><strong>{p.proAnnual}</strong><span class="muted">per org / month, billed annually</span></div>
            <p class="plan-note muted small">or {p.proMonthly} billed monthly. Unlimited users.</p>
          </div>
          <ul>
            <li class="includes">Everything in Free, plus:</li>
            <li><Check />Up to {p.proDataSources} data sources and {p.proAgents} agents and personas</li>
            <li><Check />Workflow actions that write back to Salesforce, with confirmation</li>
            <li><Check />Shared team prompt library</li>
            <li><Check />Admin usage dashboard and token limits</li>
            <li><Check />Priority support</li>
          </ul>
          <a class="btn btn-outline btn-block" href="/demo">Start a Pro trial</a>
        </div>

        <div class="plan plan-muted">
          <div class="plan-head"><h2 class="h-plan">Enterprise</h2><span class="pill pill-grey">Regulated industries</span></div>
          <div class="plan-pricing">
            <div class="plan-price"><span class="muted">from</span><strong>{p.enterpriseFrom}</strong><span class="muted">per org / month</span></div>
            <p class="plan-note muted small">Billed annually. Unlimited users.</p>
          </div>
          <ul>
            <li class="includes">Everything in Pro, plus:</li>
            <li><Check />Unlimited data sources and agents</li>
            <li><Check />Custom PII compliance groups</li>
            <li><Check />Compliance export and retention controls</li>
            <li><Check />Custom branding</li>
            <li><Check />Onboarding and a support SLA</li>
            <li><Check />Signed contract and data processing terms</li>
          </ul>
          <a class="btn btn-outline btn-block" href="/demo">Talk to us</a>
        </div>
      </div>

      <div class="narrow faq">
        <h2 class="h-section">Questions</h2>
        <details open>
          <summary>Do I pay for AI usage?</summary>
          <p>You pay your AI provider directly on every plan. Loom Connect never marks it up.</p>
        </details>
        <details>
          <summary>Do you charge per user?</summary>
          <p>No. Every plan is one price per Salesforce org, with unlimited users. Plans differ by how many data sources and agents you configure.</p>
        </details>
        <details>
          <summary>Is the Free plan a trial?</summary>
          <p>No. It's the full core product with no time limit.</p>
        </details>
        <details>
          <summary>Is there a discount for paying annually?</summary>
          <p>Yes. Pro is {p.proAnnual} a month billed annually, against {p.proMonthly} billed monthly. That's 2 months free each year.</p>
        </details>
        <details>
          <summary>Can I switch plans?</summary>
          <p>Yes. It's the same package, so upgrading unlocks features with nothing to reinstall.</p>
        </details>
        <details>
          <summary>What happens if prices change?</summary>
          <p>Existing customers get {p.noticePeriod} notice before any change takes effect.</p>
        </details>
        <details>
          <summary>What data is sent to the AI model?</summary>
          <p>Only fields the user can already see, with personal data pseudonymised first. The <a href="/security">security page</a> explains the full data flow.</p>
        </details>
      </div>
    </div>
  </section>
</Base>
