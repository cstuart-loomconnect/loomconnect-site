---
import PolicyPage from '../layouts/PolicyPage.astro';
import { site } from '../site.config.js';
const sections = [
  { id: 'who', label: 'Who we are' },
  { id: 'forms', label: 'Data we collect from our website' },
  { id: 'org', label: 'Data inside your Salesforce org' },
  { id: 'providers', label: 'AI providers you connect' },
  { id: 'retention', label: 'How long we keep data' },
  { id: 'rights', label: 'Your rights under UK GDPR' },
  { id: 'contact', label: 'Contact us' },
];
---
<PolicyPage
  title="Privacy policy"
  description="How Loom Connect handles personal data."
  summary="AI Assist runs inside your Salesforce org, so we never receive your customer data. We only hold what you send us directly through our website forms and support emails."
  draft
  sections={sections}
>
  <p slot="who">{site.name} is a trading name of {site.owner.legalName}, {site.owner.address}. [Full text to come.]</p>
  <p slot="contact">Questions about privacy: <a href={`mailto:${site.email.privacy}`}>{site.email.privacy}</a></p>
</PolicyPage>
