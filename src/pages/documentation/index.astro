---
// /documentation: the home page of the docs. The lists below build themselves from settings.js.
import DocsLayout from '../../layouts/DocsLayout.astro';
import { sections } from '../../documentation/settings.js';
import { pageUrl, pagesInSection, setupPages, setupMinutes } from '../../documentation/navigation.js';

// The reference groups, i.e. every group except the setup path
const referenceSections = sections.filter((section) => !section.setup);
---
<DocsLayout slug="">
  <p class="docs-lede">AI Assist puts an AI chat window on your Salesforce record pages. Your users ask about the record in front of them, and the assistant answers using only the data you let it see.</p>

  <h2 id="set-up">Set up AI Assist</h2>
  <p>Work through these {setupPages.length} pages in order. Each one ends with a link to the next. Most admins have a working assistant in about {Math.round(setupMinutes / 15) * 15} minutes.</p>
  <ol class="docs-path">
    {setupPages.map((page, index) => (
      <li>
        <a href={pageUrl(page.slug)}>
          <b>{index + 1}</b>
          <strong>{page.title}</strong>
          <span>{page.minutes} min</span>
        </a>
      </li>
    ))}
  </ol>

  <h2 id="reference">Already set up</h2>
  <div class="docs-split">
    {referenceSections.map((section) => (
      <div>
        <h3>{section.title}</h3>
        <ul>
          {pagesInSection(section.id).map((page) => (
            <li><a href={pageUrl(page.slug)}>{page.title}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</DocsLayout>
