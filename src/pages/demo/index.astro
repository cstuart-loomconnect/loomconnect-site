---
import Base from '../../layouts/Base.astro';
import Check from '../../components/Check.astro';
import FormGuard from '../../components/FormGuard.astro';
import Turnstile from '../../components/Turnstile.astro';
import { site } from '../../site.config.js';
import { useProxy } from '../../site-key.js';

// The form posts to the Worker, which adds the org ID and talks to Salesforce.
// With no Turnstile key (local preview) it goes straight to the thank-you page instead.
const action = useProxy ? '/api/demo' : '/demo/thanks';
const method = useProxy ? 'post' : 'get';
---
<Base title="Request a demo" description="Book a 30-minute walkthrough of LoomConnect AI.">
  <section class="section bg-soft">
    <div class="container form-layout">
      <div class="stack stack-md">
        <h1>See LoomConnect AI working in a real org</h1>
        <p class="lead">Book a 30-minute walkthrough. Bring your questions about setup, data handling and what your team could use it for.</p>
        <ul class="ticks">
          <li><Check color="#B45309" />A live demo on sample Salesforce records</li>
          <li><Check color="#B45309" />How permissions and PII protection work</li>
          <li><Check color="#B45309" />Help planning a sandbox install</li>
        </ul>
        <p class="note">Prefer email? Write to <a href={`mailto:${site.email.hello}`}><strong>{site.email.hello}</strong></a></p>
      </div>

      <!-- Demo form. Posts to the Worker (src/worker.js), which forwards to Salesforce Web-to-Lead. -->
      <form class="form-card" action={action} method={method} aria-label="Request a demo">
        {!useProxy && <p class="dev-banner">Preview mode: this form isn't connected to Salesforce yet.</p>}

        <div class="field-row">
          <div class="field">
            <label for="first_name">First name</label>
            <input id="first_name" name="first_name" type="text" autocomplete="given-name" maxlength="40" required />
          </div>
          <div class="field">
            <label for="last_name">Last name</label>
            <input id="last_name" name="last_name" type="text" autocomplete="family-name" maxlength="80" required />
          </div>
        </div>
        <div class="field">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="80" placeholder="name@company.com" required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" autocomplete="organization" maxlength="40" required />
          </div>
          <div class="field">
            <label for="title">Role</label>
            <input id="title" name="title" type="text" autocomplete="organization-title" maxlength="40" />
          </div>
        </div>
        <div class="field">
          <label for="team_size">Salesforce users in your team</label>
          <select id="team_size" name="team_size">
            <option value="1–10">1–10</option>
            <option value="11–50">11–50</option>
            <option value="51–200">51–200</option>
            <option value="200+">200+</option>
          </select>
        </div>
        <div class="field">
          <label for="description">What would you use LoomConnect AI for?</label>
          <textarea id="description" name="description" rows="4"></textarea>
        </div>
        <div class="check">
          <input id="consent" type="checkbox" required />
          <label for="consent">I agree to LoomConnect contacting me about this request. See the <a href="/privacy">privacy policy</a>.</label>
        </div>

        <FormGuard proxy={useProxy} />
        <Turnstile />

        <button class="btn btn-primary btn-block" type="submit">Request my demo</button>
        <p class="hint text-center">We usually reply within one working day.</p>
      </form>
    </div>
  </section>
</Base>
