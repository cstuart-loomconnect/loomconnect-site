---
import Base from '../../layouts/Base.astro';
import Check from '../../components/Check.astro';
---
<Base title="Thanks for your request">
  <section class="section">
    <div class="container narrow stack stack-md center">
      <span class="confirm-icon"><Check size={36} /></span>
      <h1>Thanks, your request is in</h1>
      <p class="lead">We'll email you within one working day to find a time. </p>
      <ol class="next-steps">
        <li>Watch your inbox for our reply</li>
        <li>Pick a 30-minute slot that suits you</li>
        <li>See LoomConnect AI live and plan your install</li>
      </ol>
      <div class="btn-row btn-row-center">
        <a class="btn btn-primary" href="/documentation">Read the setup guide</a>
        <a class="btn btn-outline" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Base>
