---
import Base from '../layouts/Base.astro';
import { site } from '../site.config.js';
---
<Base title="About" description="LoomConnect builds AI tools for Salesforce teams.">
  <section class="section">
    <div class="container narrow stack stack-md">
      <h1>Built by a Salesforce developer, for Salesforce teams</h1>
      <div class="founder">
        <span class="avatar" aria-hidden="true">CS</span>
        <div><strong>Chandler Stuart</strong><br /><span class="muted small">Founder and Salesforce Developer</span></div>
      </div>
      <p class="lead">I started on Salesforce as an apprentice and have spent years building on the platform. LoomConnect AI exists because teams wanted AI on their records without sending their data somewhere they couldn't see.</p>
      <p class="lead">LoomConnect is named for the idea behind it: weaving AI into the platform you already use, thread by thread.</p>
    </div>
    <!-- Logo sting: plays once when scrolled into view (src/scripts/play-once.js). Files live in public/video/ -->
    <div class="container narrow">
      <figure class="logo-sting">
        <video data-play-once muted playsinline preload="metadata" poster="/video/loomconnect-sting.jpg" width="1200" height="350" aria-label="The LoomConnect logo: two threads weaving together into one mark">
          <source src="/video/loomconnect-sting.mp4" type="video/mp4" />
        </video>
        <figcaption class="small muted">Two threads, over and under: your records and your AI, woven together.</figcaption>
      </figure>
    </div>
  </section>
  <section class="section-sm bg-soft">
    <div class="container stack-lg">
      <h2>What we believe</h2>
      <div class="grid">
        <div class="card"><h3>Native first</h3><p>If Salesforce can already do it, we use Salesforce.</p></div>
        <div class="card"><h3>Your data, your org</h3><p>No middleman servers between you and your AI provider.</p></div>
        <div class="card"><h3>A real free plan</h3><p>Useful on day one, not a trial with a countdown.</p></div>
      </div>
      <div class="btn-row">
        <a class="btn btn-outline" href={`mailto:${site.email.hello}`}>Get in touch</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { setUpPlayOnce } from '../scripts/play-once.js';
  setUpPlayOnce();
</script>
