---
// Spam traps and the error message for a Salesforce form. Place inside the <form>.
//
// Proxy mode (Turnstile site key set): the traps use fixed names and the Worker (src/worker.js) checks them
//   and never forwards them to Salesforce. No Salesforce fields are needed.
// Direct mode: the traps post to Salesforce, so they only render once you create the fields and set
//   honeypotFieldId / timerFieldId in src/site.config.js (Salesforce drops names it doesn't recognise).
import { HONEYPOT_NAME, TIMER_NAME } from '../form-fields.js';
const { proxy = false, honeypotFieldId = '', timerFieldId = '' } = Astro.props;
const honeypotName = proxy ? HONEYPOT_NAME : honeypotFieldId;
const timerName = proxy ? TIMER_NAME : timerFieldId;
---
{proxy && <p class="form-error" role="alert" data-form-error hidden></p>}
{honeypotName && (
  <div class="hp" aria-hidden="true">
    <label for="contact_me_by_fax">Leave this field empty</label>
    <input id="contact_me_by_fax" name={honeypotName} type="text" tabindex="-1" autocomplete="off" />
  </div>
)}
{timerName && <input type="hidden" name={timerName} value="" data-form-timer />}
{(proxy || honeypotName || timerName) && (
  <script>
    import { setUpFormGuard } from '../scripts/form-guard.js';
    setUpFormGuard();
  </script>
)}
