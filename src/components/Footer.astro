---
import { site } from '../site.config.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <strong>{site.name}</strong>
        <p>AI tools for Salesforce teams, built on the platform you already trust.</p>
        <a href={`mailto:${site.email.hello}`}>{site.email.hello}</a>
      </div>
      <div class="footer-cols">
        <nav aria-label="Product">
          <span>Product</span>
          <a href="/">AI Assist</a>
          <a href="/pricing">Pricing</a>
          <a href="/security">Security</a>
          <a href="/docs">Docs</a>
          <a href="/release-notes">Release notes</a>
        </nav>
        <nav aria-label="Company">
          <span>Company</span>
          <a href="/about">About</a>
          <a href="/demo">Request a demo</a>
          <a href="/support">Support</a>
          <a href="/support-policy">Support policy</a>
        </nav>
        <nav aria-label="Trust and legal">
          <span>Trust and legal</span>
          <a href="/privacy">Privacy policy</a>
          <a href="/terms">Terms of service</a>
          <a href="/acceptable-use">Acceptable use</a>
          <a href="/ai-transparency">AI transparency</a>
          <a href="/subprocessors">Sub-processors</a>
          <a href="/accessibility">Accessibility</a>
        </nav>
      </div>
    </div>
    <div class="footer-legal">
      <p>{site.name} is a trading name of {site.owner.legalName}, {site.owner.address}.</p>
      <p>© {year} {site.name}. Salesforce and AppExchange are trademarks of Salesforce, Inc.</p>
    </div>
  </div>
</footer>
